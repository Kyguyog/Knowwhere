# Copy to .env and set a long, unique password before starting.
ADMIN_USER=admin
ADMIN_PASSWORD=8-char-or-longer!
PORT=8080
# Concurrent subcollection checks (1–32). Lower this if Firestore throttles requests.
BACKUP_CONCURRENCY=8
# Set before publishing or pulling your image, e.g. yourname/fsbak:latest
IMAGE=kyguy2/fsbak:latest
